{
  "name": "solid-recharts-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "ref:setup": "bash scripts/setup-reference.sh",
    "ref:verify": "node scripts/verify-reference.mjs",
    "test": "pnpm --filter solid-recharts test",
    "test:watch": "pnpm --filter solid-recharts test:watch",
    "typecheck": "pnpm -r typecheck",
    "lint": "vp lint --type-aware --tsconfig ./packages/solid-recharts/tsconfig.json packages/solid-recharts/src",
    "dev": "pnpm --filter @solid-recharts/dev dev",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@solidjs/diagnostics": "2.0.0-rc.19",
    "@solidjs/vite-plugin": "3.0.0-next.52",
    "@solidjs/web": "2.0.0-rc.19",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^24.19.2",
    "eslint-plugin-solid": "^0.18.1",
    "jsdom": "^30.1.3",
    "solid-js": "2.0.0-rc.19",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "^1.4.0",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.16.1"
}
